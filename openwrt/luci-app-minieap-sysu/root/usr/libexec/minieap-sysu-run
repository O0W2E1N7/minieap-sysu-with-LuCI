#!/bin/sh
# Keep procd's PID as the session identity. Capture only this child's live output.
umask 077
session_dir="/tmp/minieap-sysu-live-$$"
mkdir -p "$session_dir" || exit 1
chmod 700 "$session_dir"
rm -f "$session_dir/output" "$session_dir/state.json" "$session_dir/state.json.tmp" "$session_dir/nic"
# The configured nic is the single source of truth; fall back to eth0 when absent.
NIC=$(sed -n 's/^[[:space:]]*nic=//p' /etc/minieap-sysu.conf 2>/dev/null | head -n 1 | tr -d '\r')
case "$NIC" in
    ""|*[!A-Za-z0-9_.:-]*) NIC=eth0 ;;
esac
[ "${#NIC}" -le 15 ] || NIC=eth0
# Remember what this instance actually uses, so the page can tell a saved change
# apart from an applied one.
printf '%s\n' "$NIC" > "$session_dir/nic"
auth_pid=
monitor_pid=
cleanup() {
    trap - EXIT INT TERM
    [ -z "$auth_pid" ] || kill "$auth_pid" 2>/dev/null
    [ -z "$monitor_pid" ] || kill "$monitor_pid" 2>/dev/null
    wait 2>/dev/null
    rm -f "$session_dir/output" "$session_dir/state.json" "$session_dir/state.json.tmp" "$session_dir/nic"
    rmdir "$session_dir" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 0' INT TERM
# Wait for the configured interface, but leave a trace instead of blocking silently.
waited=0
while [ "$(cat "/sys/class/net/$NIC/carrier" 2>/dev/null)" != 1 ]; do
    sleep 1
    waited=$((waited + 1))
    if [ $((waited % 30)) -eq 0 ]; then
        echo "等待 $NIC 链路已 $waited 秒"
    fi
done
mkfifo "$session_dir/output" || exit 1
lua /usr/libexec/minieap-sysu-monitor.lua "$session_dir" "$NIC" < "$session_dir/output" &
monitor_pid=$!
/usr/sbin/minieap-sysu --conf-file /etc/minieap-sysu.conf -b 0 > "$session_dir/output" 2>&1 &
auth_pid=$!
wait "$auth_pid"
result=$?
auth_pid=
wait "$monitor_pid"
monitor_pid=
exit "$result"
